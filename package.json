{
  "name": "ai-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:server": "node --test tests-server/*.test.*",
    "dev:pages": "wrangler pages dev dist",
    "deploy:pages": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vite": "^7.2.0",
    "wrangler": "^4.161.0"
  }
}
